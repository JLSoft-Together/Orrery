{
  "name": "@ccm/pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "node scripts/ensure-wasm.mjs && vite --host",
    "build": "node scripts/ensure-wasm.mjs && vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "node scripts/ensure-wasm.mjs && vue-tsc --noEmit -p tsconfig.json",
    "test": "node scripts/ensure-wasm.mjs && vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@ccm/shared": "*",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^0.544.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eruda": "3.4.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.0.0",
    "playwright": "1.65.0",
    "qrcode": "^1.5.4",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.1"
  }
}
