{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.ccm.monitor",
  "mainBinaryName": "Orrery",
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Orrery",
    "copyright": "Orrery",
    "category": "DeveloperTool",
    "shortDescription": "Orrery",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../web/dist/": "web/",
      "../layout-daemon/init/ccm-project-model.gradle": "layout-daemon/ccm-project-model.gradle"
    },
    "externalBin": ["binaries/orrery-core", "binaries/orrery-bridge"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "windowSize": { "width": 540, "height": 380 }
      }
    }
  }
}
