{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@core": ["src/core"],
      "@core/*": ["src/core/*"],
      "@features": ["src/features"],
      "@features/*": ["src/features/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
