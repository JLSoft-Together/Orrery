{
  "name": "claude-code-monitor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n collector,web -c blue,green \"npm:dev -w @ccm/collector\" \"npm:dev -w @ccm/web\"",
    "build": "npm run build -w @ccm/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "qa": "node scripts/qa-fast.mjs",
    "desktop": "npm run build -w @ccm/web && npm run start -w @ccm/desktop",
    "shell:dev": "npm run build -w @ccm/web && node scripts/gen-desk-shim.mjs && cargo run -j 4 --manifest-path apps/shell/Cargo.toml",
    "desktop:dev": "concurrently -k -n web,desktop -c green,magenta \"npm:dev -w @ccm/web\" \"npm:start:dev -w @ccm/desktop\"",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist-tauri.mjs --win",
    "dist:mac": "node scripts/dist-tauri.mjs --mac",
    "dist:electron": "node scripts/dist.mjs --electron",
    "dist:electron:win": "npm run build -w @ccm/web && npm run dist -w @ccm/desktop",
    "dist:electron:mac": "npm run build -w @ccm/web && npm run dist:mac -w @ccm/desktop"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
